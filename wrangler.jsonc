{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "purplelittleguy",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only these paths wake the Worker. Everything else is served as a plain file, which is free.
    "run_worker_first": ["/api/*", "/g/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "purplelittleguy",
      // From `bunx wrangler d1 create purplelittleguy`. A fork needs its own.
      "database_id": "3d1c49a3-33e9-4db6-bce1-d9b8217473b3",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Deploying attaches the domain and creates its DNS record and certificate.
  "routes": [{ "pattern": "purplelittleguy.com", "custom_domain": true }]
}
